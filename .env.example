# Local development defaults. Copy to .env before running Compose.
PORT=2567
PUBLIC_SERVER_URL=http://localhost:2567
ALLOWED_ORIGINS=http://localhost:2567
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=/data/office.sqlite
GUEST_INVITE_CODE=replace-with-an-invite-code
OFFICE_ID=demo-office

LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-characters

# AI is opt-in. Start the worker with: docker compose --profile ai up --build
AI_ENABLED=false
AI_WORKER_SECRET=replace-with-a-separate-32-character-random-secret
AI_SERVER_URL=http://server:2567
AI_MAX_DURATION_SECONDS=600
AI_MAX_TRANSCRIPT_CHARS=100000
AI_MAX_CONCURRENT_SESSIONS=2
# Gemini-only demo defaults. Credentials stay in the worker environment.
OPENAI_API_KEY=
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
AI_SUMMARY_MODEL=gemini-3.6-flash
AI_CHUNK_SECONDS=10
AI_PROVIDER_TIMEOUT_MS=30000

# Select gemini to use Google for BOTH audio transcription and notes; no fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Timezone used to resolve spoken relative deadlines in office notes.
AI_TIMEZONE=America/Denver

# schema uses native constrained output; json supplies the schema in the prompt and validates locally.
AI_GEMINI_OUTPUT_MODE=json

# Persistent local accounting, shared by the demo, CLI, and host worker. This cap is not Google''s quota.
AI_USAGE_DATABASE=./data/ai-usage.sqlite
AI_LOCAL_DAILY_REQUEST_LIMIT=20

# Local review history (message/task drafts and cited excerpts). No external delivery.
AI_REVIEW_DATABASE=./data/ai-followups.sqlite
