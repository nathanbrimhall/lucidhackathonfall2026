{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "frontend/**/*.ts",
    "server/src/**/*.ts",
    "server/test/**/*.ts",
    "shared/src/**/*.ts",
    "tools/**/*.ts",
    "worker/**/*.ts",
    "agent-worker/**/*.ts"
  ]
}
